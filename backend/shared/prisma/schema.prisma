// Financial Analytics Dashboard - Database Schema
// OLAP-optimized schema for healthcare revenue analytics

generator client {
  provider = "prisma-client-js"
  output   = "../backend/shared/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// DIMENSION TABLES (Slowly Changing Dimensions)
// ============================================================================

enum FacilityType {
  HOSPITAL
  CLINIC
  URGENT_CARE
  SPECIALTY_CENTER
}

model Facility {
  id          String       @id @default(uuid())
  name        String
  type        FacilityType
  bedCount    Int?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  isActive    Boolean      @default(true)

  departments Department[]
  claims      Claim[]
  kpiSnapshots KPISnapshot[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("facilities")
}

model Department {
  id          String   @id @default(uuid())
  name        String
  specialty   String?
  code        String?

  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  claims      Claim[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([facilityId])
  @@index([specialty])
  @@map("departments")
}

enum PayerType {
  MEDICARE
  MEDICAID
  BLUE_CROSS_BLUE_SHIELD
  AETNA
  UNITED_HEALTHCARE
  COMMERCIAL
  SELF_PAY
  OTHER
}

model Payer {
  id             String    @id @default(uuid())
  name           String
  type           PayerType
  contractRate   Float?    // Average reimbursement rate
  averageDaysToPay Int?

  claims         Claim[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([type])
  @@map("payers")
}

// ============================================================================
// FACT TABLE (Claims - Core Transaction Data)
// ============================================================================

enum ClaimStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  DENIED
  PAID
  PARTIAL_PAYMENT
  APPEALED
  WRITTEN_OFF
}

model Claim {
  id                 String      @id @default(uuid())

  // Foreign Keys to Dimensions
  facilityId         String
  facility           Facility    @relation(fields: [facilityId], references: [id])

  departmentId       String
  department         Department  @relation(fields: [departmentId], references: [id])

  payerId            String
  payer              Payer       @relation(fields: [payerId], references: [id])

  // Patient Information
  patientId          String
  patientName        String
  patientDOB         DateTime?
  patientPhone       String?

  // Claim Identification
  claimNumber        String      @unique
  accountNumber      String?

  // Dates (Critical for A/R aging)
  serviceDate        DateTime
  submissionDate     DateTime?
  adjudicationDate   DateTime?
  paymentDate        DateTime?
  dueDate            DateTime?

  // Financial Measures (Facts)
  grossAmount        Float       // Total charges
  adjustmentAmount   Float       @default(0) // Contractual adjustments
  netAmount          Float       // Gross - Adjustments
  paymentAmount      Float       @default(0) // Amount paid
  outstandingAmount  Float       // Net - Payment

  // Claim Details
  status             ClaimStatus @default(SUBMITTED)
  denialReason       String?
  denialCode         String?
  serviceType        String?
  diagnosisCode      String?     // ICD-10
  procedureCode      String?     // CPT
  units              Int         @default(1)

  // Audit
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  createdBy          String?
  updatedBy          String?

  @@index([facilityId, serviceDate])
  @@index([departmentId])
  @@index([payerId])
  @@index([status])
  @@index([serviceDate])
  @@index([paymentDate])
  @@index([claimNumber])
  @@index([patientId])
  @@map("claims")
}

// ============================================================================
// MATERIALIZED VIEW (Pre-aggregated KPIs for Performance)
// ============================================================================

model KPISnapshot {
  id                   String   @id @default(uuid())

  // Dimensions
  facilityId           String?
  facility             Facility? @relation(fields: [facilityId], references: [id])
  snapshotDate         DateTime // Date this snapshot represents
  snapshotPeriod       String   // 'daily', 'weekly', 'monthly'

  // Revenue Metrics
  grossRevenue         Float    @default(0)
  netRevenue           Float    @default(0)
  adjustmentAmount     Float    @default(0)
  cashCollections      Float    @default(0)
  revenuePerPatient    Float    @default(0)

  // Collection & A/R Metrics
  collectionRate       Float    @default(0)  // Percentage
  daysInAR             Float    @default(0)
  outstandingBalance   Float    @default(0)
  arAging_0_30         Float    @default(0)
  arAging_31_60        Float    @default(0)
  arAging_61_90        Float    @default(0)
  arAging_91_120       Float    @default(0)
  arAging_120_plus     Float    @default(0)

  // Claims Metrics
  totalClaims          Int      @default(0)
  claimsSubmitted      Int      @default(0)
  claimsAccepted       Int      @default(0)
  claimsDenied         Int      @default(0)
  claimsPaid           Int      @default(0)
  cleanClaimRate       Float    @default(0)  // Percentage
  denialRate           Float    @default(0)  // Percentage
  denialRecoveryRate   Float    @default(0)  // Percentage

  // Operational Metrics
  patientVolume        Int      @default(0)
  revenueCycleDays     Float    @default(0)

  createdAt            DateTime @default(now())

  @@unique([facilityId, snapshotDate, snapshotPeriod])
  @@index([facilityId, snapshotDate])
  @@index([snapshotDate])
  @@map("kpi_snapshots")
}

// ============================================================================
// USER MANAGEMENT & AUTHENTICATION
// ============================================================================

enum UserRole {
  ADMIN
  EXECUTIVE
  ANALYST
  FACILITY_MANAGER
}

model User {
  id                String      @id @default(uuid())
  email             String      @unique
  passwordHash      String
  name              String
  role              UserRole    @default(ANALYST)
  isActive          Boolean     @default(true)
  emailVerified     Boolean     @default(false)

  // Facility Access (for FACILITY_MANAGER role)
  facilityAccess    String[]    // Array of facility IDs

  // Session Management
  lastLogin         DateTime?
  refreshTokens     RefreshToken[]

  // Audit
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================================================
// ALERTS & NOTIFICATIONS
// ============================================================================

enum AlertLevel {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  SNOOZED
}

model Alert {
  id              String      @id @default(uuid())
  title           String
  message         String
  level           AlertLevel
  status          AlertStatus @default(ACTIVE)

  // Context
  facilityId      String?
  metricName      String
  metricValue     Float
  thresholdValue  Float

  // Recipients
  notifiedUsers   String[]    // Array of user IDs

  // Status tracking
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  resolvedBy      String?
  resolvedAt      DateTime?
  snoozedUntil    DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([level])
  @@index([facilityId])
  @@index([createdAt])
  @@map("alerts")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  REPORT_GENERATED
}

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  action      AuditAction
  entity      String      // e.g., 'Claim', 'User', 'Report'
  entityId    String?
  details     Json?       // Additional context
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// SCHEDULED REPORTS
// ============================================================================

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
}

model ScheduledReport {
  id          String          @id @default(uuid())
  name        String
  description String?
  template    String          // Report template name
  format      ReportFormat
  frequency   ReportFrequency

  // Schedule
  dayOfWeek   Int?            // 0-6 (Sunday-Saturday) for WEEKLY
  dayOfMonth  Int?            // 1-31 for MONTHLY
  timeOfDay   String          // HH:MM format
  timezone    String          @default("UTC")

  // Recipients
  recipients  String[]        // Email addresses

  // Filters
  filters     Json?

  // Status
  isActive    Boolean         @default(true)
  lastRun     DateTime?
  nextRun     DateTime?

  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isActive])
  @@index([nextRun])
  @@map("scheduled_reports")
}
