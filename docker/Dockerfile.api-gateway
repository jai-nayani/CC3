FROM node:20-alpine AS builder

WORKDIR /app

# Copy shared module first
COPY backend/shared /app/shared
WORKDIR /app/shared
RUN npm ci && npx prisma generate && npm run build

# Build api-gateway
WORKDIR /app/api-gateway
COPY backend/api-gateway/package*.json ./
RUN npm ci --only=production

COPY backend/api-gateway .
RUN npm run build

# Production stage
FROM node:20-alpine

WORKDIR /app

COPY --from=builder /app/api-gateway/dist ./dist
COPY --from=builder /app/api-gateway/node_modules ./node_modules
COPY --from=builder /app/api-gateway/package.json ./package.json
COPY --from=builder /app/shared/node_modules/@prisma ./node_modules/@prisma

ENV NODE_ENV=production
EXPOSE 4000

CMD ["node", "dist/main.js"]
